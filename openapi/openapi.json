{
  "openapi": "3.1.0",
  "info": {
    "title": "Life Manager API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "version"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "getMe",
        "tags": [
          "account"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "account",
                    "workspace"
                  ],
                  "properties": {
                    "account": {
                      "type": "object",
                      "required": [
                        "id",
                        "email",
                        "name",
                        "image"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "image": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    "workspace": {
                      "type": "object",
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/account": {
      "delete": {
        "operationId": "deleteAccount",
        "tags": [
          "account"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "confirmation"
                ],
                "properties": {
                  "confirmation": {
                    "type": "string",
                    "description": "Must be exactly \"DELETE MY ACCOUNT\""
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Deleted; every session is revoked and the cookie cleared"
          }
        }
      }
    },
    "/v1/workspace/settings": {
      "get": {
        "operationId": "getWorkspaceSettings",
        "tags": [
          "settings"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "weekStartDay",
                    "timeZone",
                    "defaultDailyCapacityMinutes",
                    "version",
                    "updatedAt"
                  ],
                  "properties": {
                    "weekStartDay": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6,
                      "description": "0 = Sunday"
                    },
                    "timeZone": {
                      "type": "string",
                      "description": "IANA time zone"
                    },
                    "defaultDailyCapacityMinutes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1440
                    },
                    "version": {
                      "type": "integer"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateWorkspaceSettings",
        "tags": [
          "settings"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "weekStartDay": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                  },
                  "timeZone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "defaultDailyCapacityMinutes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1440
                  }
                },
                "additionalProperties": false,
                "minProperties": 1
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "header",
            "name": "idempotency-key",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "weekStartDay",
                    "timeZone",
                    "defaultDailyCapacityMinutes",
                    "version",
                    "updatedAt"
                  ],
                  "properties": {
                    "weekStartDay": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6,
                      "description": "0 = Sunday"
                    },
                    "timeZone": {
                      "type": "string",
                      "description": "IANA time zone"
                    },
                    "defaultDailyCapacityMinutes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1440
                    },
                    "version": {
                      "type": "integer"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/export": {
      "get": {
        "operationId": "exportAccountData",
        "tags": [
          "account"
        ],
        "parameters": [
          {
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "json"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "markdown"
                  ]
                }
              ]
            },
            "in": "query",
            "name": "format",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "The account's data as an attachment (contracts/export-format.md)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "formatVersion",
                    "exportedAt",
                    "account",
                    "workspace",
                    "securityEvents"
                  ],
                  "properties": {
                    "formatVersion": {
                      "type": "integer"
                    },
                    "exportedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "account": {
                      "type": "object",
                      "required": [
                        "id",
                        "email",
                        "name",
                        "createdAt"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "name": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    },
                    "workspace": {
                      "type": "object",
                      "required": [
                        "id",
                        "createdAt",
                        "settings"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "settings": {
                          "type": "object",
                          "required": [
                            "weekStartDay",
                            "timeZone",
                            "defaultDailyCapacityMinutes",
                            "updatedAt"
                          ],
                          "properties": {
                            "weekStartDay": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 6,
                              "description": "0 = Sunday"
                            },
                            "timeZone": {
                              "type": "string",
                              "description": "IANA time zone"
                            },
                            "defaultDailyCapacityMinutes": {
                              "type": "integer"
                            },
                            "updatedAt": {
                              "type": "string",
                              "format": "date-time"
                            }
                          }
                        }
                      }
                    },
                    "securityEvents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "type",
                          "occurredAt"
                        ],
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "occurredAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://api.life.bystan.tech"
    }
  ]
}
