# Copy to .env.local for development. Never commit real values.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Shows the test sign-in form (local and staging only; the API refuses it in production).
# The form asks for the API's TEST_SIGN_IN_SECRET; never put that secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_TEST_SIGN_IN=true
