{
  "name": "cloud-stanos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "check": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "e2e": "playwright test",
    "api:generate": "orval --config orval.config.ts",
    "api:check": "orval --config orval.config.ts && git diff --exit-code -- src/lib/api/generated"
  },
  "dependencies": {
    "@serwist/turbopack": "9.5.13",
    "@tanstack/query-async-storage-persister": "5.104.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-persist-client": "5.104.1",
    "idb-keyval": "6.3.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serwist": "9.5.13"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.2",
    "orval": "8.40.0",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
